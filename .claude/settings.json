{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,sys,subprocess\np='.claude/hooks/win-cmd-check.py'\nsys.exit(subprocess.run([sys.executable,p],stdin=sys.stdin).returncode if os.path.exists(p) else 0)"
            ],
            "statusMessage": "Checking pasteable commands are Windows-ready"
          }
        ]
      }
    ]
  }
}
